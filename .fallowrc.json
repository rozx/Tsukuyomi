{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "quasar.config.ts",
    "src/App.vue",
    "src/router/index.ts",
    "src/router/routes.ts",
    "src/stores/index.ts",
    "src/layouts/**/*.vue",
    "src/pages/**/*.vue",
    "src/boot/**/*.ts",
    "src/css/**/*.{css,scss}",
    "src/__tests__/**/*.test.ts",
    "src/**/*.test.ts",
    "src-electron/electron-main.ts",
    "src-electron/electron-preload.ts",
    "scripts/**/*.ts"
  ],
  "ignorePatterns": [
    "src/__tests__/examplePages/**",
    "src/auto-components.d.ts",
    "src/auto-imports.d.ts"
  ],
  "ignoreDependencies": [
    "@quasar/extras",
    "@intlify/unplugin-vue-i18n",
    "unplugin-auto-import",
    "vite-plugin-checker",
    "vite"
  ],
  "rules": {
    "unused-files": "error",
    "unused-exports": "warn",
    "unused-types": "off",
    "unresolved-imports": "error"
  },
  "duplicates": {
    "mode": "mild",
    "minTokens": 50,
    "minLines": 5,
    "threshold": 10
  },
  "health": {
    "maxCyclomatic": 20,
    "maxCognitive": 15,
    "ignore": ["**/*.generated.ts"]
  },
  "boundaries": {
    "preset": "bulletproof"
  }
}
