{
  "name": "tsukuyomi-translator",
  "version": "0.13.0",
  "description": "Tsukuyomi - Moonlit Translator",
  "productName": "Tsukuyomi - Moonlit Translator",
  "author": "rozx <rozx@heavyskymobile.com>",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rozx/Tsukuyomi.git"
  },
  "scripts": {
    "lint": "bunx eslint --quiet .",
    "type-check": "bunx vue-tsc --noEmit",
    "quality-check": "cross-env FALLOW_COVERAGE=coverage/coverage-final.json bunx fallow --baseline .fallow-baseline.json",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vitest",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vitest run --coverage",
    "test:bun": "bun test",
    "bump": "bun scripts/bump-version.ts",
    "setup:git-hooks": "node scripts/setup-git-hooks.js",
    "dev": "quasar dev",
    "dev:electron": "quasar dev -m electron",
    "build": "quasar build",
    "build:spa": "cross-env NODE_ENV=production quasar build -m spa",
    "build:electron": "cross-env NODE_ENV=production quasar build -m electron",
    "build:electron:debug": "ELECTRON_DEBUG=true quasar build -m electron",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/transformers": "^4.2.0",
    "@octokit/rest": "^22.0.1",
    "@primevue/themes": "^4.5.4",
    "@quasar/extras": "^1.18.0",
    "@tanstack/vue-virtual": "^3.13.30",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "co": "^4.6.0",
    "dompurify": "^3.4.11",
    "fuse.js": "^7.4.2",
    "gpt-tokenizer": "^3.4.0",
    "http-proxy-middleware": "^3.0.7",
    "idb": "^8.0.3",
    "jsonrepair": "^3.14.1",
    "lodash": "^4.18.1",
    "marked": "^17.0.6",
    "openai": "^6.45.0",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "puppeteer": "^24.43.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-in-electron": "^3.0.5",
    "quasar": "^2.20.1",
    "uuid": "^14.0.1",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@quasar/app-vite": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/co": "^4.6.6",
    "@types/dompurify": "^3.2.0",
    "@types/electron": "^1.6.12",
    "@types/lodash": "^4.17.24",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.13.2",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-istanbul": "^4.1.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "fake-indexeddb": "^6.2.5",
    "fallow": "2.44.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.5",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite-plugin-checker": "^0.11.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
